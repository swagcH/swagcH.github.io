/* 四张设计稿共用的浅色编辑型视觉系统。 */
:root {
  --canvas: #f2f2f3;
  --paper: #ffffff;
  --ink: #151517;
  --ink-soft: #333338;
  --muted: #74747c;
  --faint: #a2a2aa;
  --line: #e8e8eb;
  --line-strong: #d9d9df;
  --surface: #f8f8f9;
  --surface-hover: #f4f3f8;
  --accent: #713cff;
  --accent-soft: #f0ebff;
  --code-bg: #171719;
  --code-text: #e8e8ec;
  --serif: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", Georgia, serif;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
}

* {
  box-sizing: border-box;
  letter-spacing: 0;
}

html {
  background: var(--canvas);
  color: var(--ink);
  scroll-behavior: smooth;
}

body {
  background: var(--canvas) !important;
  color: var(--ink) !important;
  font-family: var(--sans) !important;
  font-size: 15px;
  line-height: 1.75;
  margin: 0 !important;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 0 !important;
}

::selection {
  background: var(--accent-soft);
  color: var(--ink);
}

a,
span.exturl {
  border-bottom: 0;
  color: inherit;
  text-decoration: none;
}

a:hover,
span.exturl:hover {
  border-bottom: 0;
  color: var(--accent);
}

button,
input {
  font: inherit;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.headband,
.sidebar,
.sidebar-toggle,
.sidebar-dimmer,
.book-mark-link {
  display: none !important;
}

.main {
  background: var(--paper) !important;
  display: block !important;
  margin: 56px auto 0 !important;
  max-width: 1280px !important;
  min-height: calc(100vh - 168px);
  padding: 0 !important;
  width: calc(100% - 96px) !important;
}

.main > .column {
  min-height: 0 !important;
  position: static !important;
  width: 100% !important;
}

.main-inner {
  box-sizing: border-box;
  margin: 0 auto !important;
  padding: 0 !important;
  width: 100% !important;
}

.main-inner.page,
.main-inner.archive,
.main-inner.post {
  max-width: none !important;
}

/* 顶部导航 */
.header {
  align-items: center;
  background: var(--paper) !important;
  border-bottom: 1px solid var(--line);
  box-shadow: none !important;
  display: grid;
  grid-template-columns: minmax(180px, 1fr) auto minmax(180px, 1fr);
  height: 76px;
  margin: 0 !important;
  padding: 0 52px !important;
  position: relative !important;
  top: auto !important;
  width: 100% !important;
  z-index: 1000;
}

.site-brand-container {
  background: transparent !important;
  display: contents !important;
  height: auto !important;
  padding: 0 !important;
  width: auto !important;
}

.site-meta {
  grid-column: 1;
  grid-row: 1;
  justify-self: start;
  margin: 0 !important;
  padding: 0 !important;
  text-align: left !important;
}

.brand {
  border: 0 !important;
  display: inline-flex;
  padding: 0 !important;
}

.brand::before,
.logo-line {
  display: none !important;
}

.site-title {
  color: var(--ink) !important;
  font-family: var(--serif) !important;
  font-size: 21px !important;
  font-weight: 700 !important;
  line-height: 1.2 !important;
  margin: 0 !important;
}

.site-nav {
  background: transparent !important;
  border: 0 !important;
  display: block !important;
  grid-column: 2;
  grid-row: 1;
  align-self: center;
  margin: 0 !important;
  padding: 0 !important;
  width: auto !important;
}

.main-menu {
  align-items: center;
  display: flex;
  gap: 30px;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
}

.menu .menu-item {
  margin: 0 !important;
}

.menu .menu-item a,
.menu .menu-item span.exturl {
  border: 0 !important;
  color: var(--ink-soft) !important;
  font-size: 14px;
  line-height: 76px;
  padding: 0 !important;
  position: relative;
}

.menu .menu-item a::after {
  background: var(--accent);
  bottom: 21px;
  content: "";
  height: 2px;
  left: 50%;
  position: absolute;
  transform: translateX(-50%) scaleX(0);
  transition: transform 180ms ease;
  width: 18px;
}

.menu .menu-item a:hover,
.menu .menu-item-active a,
.menu .menu-item a.menu-item-active {
  background: transparent !important;
  color: var(--ink) !important;
}

.menu .menu-item a:hover::after,
.menu .menu-item-active a::after,
.menu .menu-item a.menu-item-active::after {
  transform: translateX(-50%) scaleX(1);
}

.menu-item-search {
  display: none !important;
}

.site-nav-right {
  color: var(--ink);
  display: block !important;
  grid-column: 3;
  grid-row: 1;
  align-self: center;
  justify-self: end;
  position: static !important;
}

.site-nav-right .toggle {
  align-items: center;
  cursor: pointer;
  color: var(--ink) !important;
  display: flex;
  height: 40px;
  justify-content: center;
  margin: 0 !important;
  width: 40px;
}

.site-nav-right .fa {
  font-size: 14px !important;
}

.site-nav-toggle {
  display: none;
}

/* 通用标题区 */
.page-hero {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 300px;
  padding: 82px 40px 78px;
  text-align: center;
}

.page-hero h1 {
  color: var(--ink);
  font-family: var(--serif);
  font-size: 52px;
  font-weight: 700;
  line-height: 1.2;
  margin: 0;
}

.page-hero-line {
  background: var(--accent);
  display: block;
  height: 2px;
  margin: 22px 0 17px;
  width: 74px;
}

.page-hero p {
  color: var(--ink-soft);
  font-size: 14px;
  margin: 0;
}

.section-heading {
  align-items: center;
  display: flex;
  flex-direction: column;
  margin: 0 0 52px;
  text-align: center;
}

.section-heading h2 {
  color: var(--ink);
  font-family: var(--serif);
  font-size: 30px;
  font-weight: 700;
  line-height: 1.25;
  margin: 0;
}

.section-heading > span {
  background: var(--accent);
  display: block;
  height: 2px;
  margin-top: 18px;
  width: 54px;
}

/* 首页 */
.main-inner.index {
  max-width: 1040px !important;
  padding: 0 52px 80px !important;
}

.editorial-home-intro {
  align-items: center;
  border-bottom: 1px solid var(--line);
  display: grid;
  gap: 46px;
  grid-template-columns: 132px minmax(0, 1fr);
  min-height: 430px;
  padding: 86px 34px 78px;
}

.home-avatar {
  border: 1px solid var(--line);
  border-radius: 4px;
  display: block;
  height: 132px;
  object-fit: cover;
  width: 132px;
}

.home-kicker {
  color: var(--accent);
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 700;
  margin: 0 0 14px;
}

.home-intro-copy h1 {
  color: var(--ink);
  font-family: var(--serif);
  font-size: 52px;
  line-height: 1.18;
  margin: 0;
}

.home-intro-copy .page-hero-line {
  margin: 20px 0;
}

.home-description {
  color: var(--muted);
  font-size: 16px;
  line-height: 1.9;
  margin: 0;
  max-width: 650px;
}

.home-actions {
  align-items: center;
  display: flex;
  gap: 28px;
  margin-top: 26px;
}

.home-actions a {
  color: var(--ink-soft);
  font-size: 14px;
  font-weight: 600;
}

.home-actions .home-primary-link {
  color: var(--accent);
}

.home-primary-link .fa {
  font-size: 11px;
  margin-left: 7px;
  transition: transform 160ms ease;
}

.home-primary-link:hover .fa {
  transform: translateX(3px);
}

.home-stats {
  display: flex;
  gap: 24px;
  margin-top: 30px;
}

.home-stats span {
  color: var(--muted);
  font-size: 12px;
}

.home-stats strong {
  color: var(--ink);
  font-family: var(--serif);
  font-size: 18px;
  margin-right: 5px;
}

.home-list-heading {
  align-items: baseline;
  display: flex;
  justify-content: space-between;
  padding: 62px 34px 12px;
}

.home-list-heading h2 {
  font-family: var(--serif);
  font-size: 30px;
  margin: 0;
}

.home-list-heading a {
  color: var(--accent);
  font-size: 13px;
}

.editorial-home-page .post-block {
  background: transparent !important;
  border-bottom: 1px solid var(--line);
  border-radius: 0 !important;
  box-shadow: none !important;
  margin: 0 !important;
  padding: 38px 34px !important;
  position: relative;
}

.editorial-home-page .post-block::before {
  color: var(--faint);
  content: var(--post-index);
  font-family: var(--mono);
  font-size: 11px;
  left: 0;
  position: absolute;
  top: 45px;
}

.editorial-home-page .post-content {
  margin: 0 !important;
}

.editorial-home-page .post-block.has-cover .post-content {
  display: grid;
  gap: 0 38px;
  grid-template-columns: minmax(0, 1fr) 210px;
}

.editorial-home-page .post-block.has-cover .post-header,
.editorial-home-page .post-block.has-cover .post-body {
  grid-column: 1;
}

.editorial-home-page .post-header {
  margin: 0 !important;
  padding: 0 !important;
  text-align: left;
}

.editorial-home-page .post-title {
  font-family: var(--serif);
  font-size: 27px !important;
  font-weight: 700 !important;
  line-height: 1.4;
  margin: 0 0 12px !important;
  text-align: left !important;
}

.post-title-link {
  border: 0 !important;
  color: var(--ink) !important;
}

.post-title-link::before,
.post-title-link::after {
  display: none !important;
}

.post-title-link:hover {
  color: var(--accent) !important;
}

.editorial-home-page .post-meta-container {
  margin: 0;
}

.post-meta {
  color: var(--muted) !important;
  font-size: 12px !important;
  text-align: left !important;
}

.post-meta-item-icon {
  color: var(--faint);
}

.post-meta-item:not(:first-child)::before {
  color: var(--line-strong) !important;
}

.post-meta a {
  color: var(--muted) !important;
}

.post-meta a:hover {
  color: var(--accent) !important;
}

.editorial-home-page .post-body {
  color: var(--muted) !important;
  font-size: 14px !important;
  line-height: 1.85;
  margin: 18px 0 0 !important;
  padding: 0 !important;
  text-align: left;
}

.editorial-home-page .post-body p {
  margin: 0;
}

.post-button {
  margin: 18px 0 0 !important;
  text-align: left !important;
}

.post-button .btn {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  color: var(--accent) !important;
  font-size: 13px;
  font-weight: 600;
  padding: 0 !important;
}

.post-button .btn:hover {
  background: transparent !important;
  color: var(--ink) !important;
}

.home-post-cover {
  align-self: center;
  border: 0 !important;
  grid-column: 2;
  grid-row: 1 / span 2;
  overflow: hidden;
}

.home-post-cover img {
  aspect-ratio: 4 / 3;
  display: block;
  margin: 0 !important;
  object-fit: cover;
  transition: transform 220ms ease;
  width: 100%;
}

.home-post-cover:hover img {
  transform: scale(1.025);
}

.editorial-home-page .post-footer,
.post-eof {
  display: none;
}

.home-brand-section {
  border-bottom: 1px solid var(--line);
  padding: 62px 34px 66px;
}

.home-section-heading {
  align-items: end;
  display: flex;
  justify-content: space-between;
  margin-bottom: 28px;
}

.home-section-kicker {
  color: var(--accent);
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 700;
  margin: 0 0 7px;
}

.home-section-heading h2 {
  font-family: var(--serif);
  font-size: 30px;
  line-height: 1.25;
  margin: 0;
}

.home-section-heading > a {
  color: var(--accent);
  font-size: 12px;
}

.home-series-grid {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.home-series-card {
  --series-tone: var(--accent);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 4px;
  color: var(--ink) !important;
  display: flex;
  flex-direction: column;
  min-height: 254px;
  padding: 22px;
  position: relative;
  transition: border-color 160ms ease, transform 160ms ease;
}

.home-series-card.tone-cyan,
.series-detail.tone-cyan {
  --series-tone: #0891b2;
}

.home-series-card.tone-orange,
.series-detail.tone-orange {
  --series-tone: #d95f16;
}

.home-series-card.tone-green,
.series-detail.tone-green {
  --series-tone: #21835a;
}

.home-series-card::before {
  background: var(--series-tone);
  content: "";
  height: 3px;
  left: -1px;
  position: absolute;
  right: -1px;
  top: -1px;
}

.home-series-card:hover {
  border-color: var(--series-tone);
  color: var(--ink) !important;
  transform: translateY(-2px);
}

.series-card-index {
  color: var(--faint);
  font-family: var(--mono);
  font-size: 10px;
}

.series-card-eyebrow {
  color: var(--series-tone);
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 700;
  margin: 24px 0 7px;
}

.home-series-card h3 {
  font-family: var(--serif);
  font-size: 20px;
  line-height: 1.35;
  margin: 0;
}

.series-card-description {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.75;
  margin: 12px 0 18px;
}

.series-card-meta {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 9px;
  margin-top: auto;
}

.home-featured-list {
  border-top: 1px solid var(--line);
}

.home-featured-item {
  align-items: center;
  display: grid;
  gap: 22px;
  grid-template-columns: 34px minmax(0, 1fr) 34px;
  padding: 24px 4px;
}

.home-featured-item + .home-featured-item {
  border-top: 1px solid var(--line);
}

.featured-index {
  color: var(--faint);
  font-family: var(--mono);
  font-size: 10px;
}

.featured-meta {
  color: var(--accent);
  font-family: var(--mono);
  font-size: 9px;
  margin: 0 0 5px;
  text-transform: uppercase;
}

.home-featured-item > div > a {
  color: var(--ink) !important;
  font-family: var(--serif);
  font-size: 19px;
  font-weight: 700;
  line-height: 1.45;
}

.home-featured-item > div > a:hover {
  color: var(--accent) !important;
}

.featured-excerpt {
  color: var(--muted);
  display: -webkit-box;
  font-size: 12px;
  line-height: 1.7;
  margin: 7px 0 0;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.featured-arrow {
  align-items: center;
  color: var(--muted) !important;
  display: flex;
  height: 34px;
  justify-content: center;
  width: 34px;
}

.featured-arrow:hover {
  color: var(--accent) !important;
}

.home-announcement {
  align-items: center;
  background: var(--surface);
  border-bottom: 1px solid var(--line);
  color: var(--ink) !important;
  display: grid;
  gap: 14px;
  grid-template-columns: auto auto minmax(0, 1fr) auto;
  margin: 0 34px;
  padding: 16px 18px;
}

.home-announcement > span {
  background: var(--ink);
  border-radius: 2px;
  color: #fff;
  font-size: 9px;
  padding: 4px 7px;
}

.home-announcement strong {
  font-family: var(--serif);
  font-size: 14px;
}

.home-announcement small {
  color: var(--muted);
  font-size: 11px;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-announcement .fa {
  color: var(--accent);
  font-size: 10px;
}

/* 关于页 */
.editorial-about-page .main-inner.page > .post-block > .post-header,
.editorial-category-page .main-inner.page > .post-block > .post-header {
  display: none;
}

.editorial-about-page .main-inner.page > .post-block,
.editorial-category-page .main-inner.page > .post-block {
  margin: 0 !important;
  padding: 0 !important;
}

.editorial-about-page .post-body {
  color: var(--ink-soft);
  font-size: 15px;
  margin: 0 !important;
  max-width: none !important;
  padding: 0 !important;
}

.about-intro {
  align-items: center;
  display: grid;
  gap: 44px;
  grid-template-columns: 158px minmax(0, 1fr);
  margin: 0 auto;
  max-width: 900px;
  padding: 60px 40px 82px;
}

.about-avatar {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 4px;
  height: 158px;
  overflow: hidden;
  width: 158px;
}

.about-avatar img {
  display: block;
  height: 100%;
  margin: 0 !important;
  object-fit: cover;
  width: 100%;
}

.about-intro-copy h2 {
  border-bottom: 0 !important;
  font-family: var(--serif);
  font-size: 30px;
  line-height: 1.3;
  margin: 0 0 3px;
}

.about-role {
  color: var(--ink) !important;
  font-size: 14px;
  font-weight: 600;
  margin: 0 0 15px !important;
}

.about-heading {
  margin-bottom: 15px;
}

.about-intro-copy p {
  color: var(--muted);
  line-height: 1.85;
  margin: 10px 0;
}

.about-section {
  border-top: 1px solid var(--line);
  padding: 72px 40px 84px;
}

.skill-groups,
.experience-list {
  margin: 0 auto;
  max-width: 860px;
}

.skill-row {
  align-items: baseline;
  display: grid;
  gap: 28px;
  grid-template-columns: 130px minmax(0, 1fr);
  padding: 11px 0;
}

.skill-row strong {
  color: var(--ink);
  font-size: 14px;
}

.skill-row p {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 13px;
  margin: 0;
}

.experience-list article {
  display: grid;
  gap: 34px;
  grid-template-columns: 130px minmax(0, 1fr);
  padding: 22px 0;
}

.experience-list article + article {
  border-top: 1px solid var(--line);
}

.experience-list time {
  color: var(--ink);
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 700;
  padding-top: 4px;
}

.experience-list h3 {
  font-family: var(--serif);
  font-size: 18px;
  margin: 0 0 5px;
}

.experience-list p {
  color: var(--muted);
  font-size: 14px;
  margin: 0;
}

.contact-links {
  display: flex;
  gap: 48px;
  justify-content: center;
  margin: 0 auto;
  max-width: 760px;
}

.contact-links a {
  align-items: center;
  color: var(--ink) !important;
  display: flex;
  gap: 12px;
}

.contact-links i {
  font-size: 19px;
  width: 22px;
}

.contact-links span {
  display: flex;
  flex-direction: column;
  font-size: 12px;
}

.contact-links strong {
  color: var(--muted);
  font-size: 11px;
  font-weight: 400;
}

.contact-links a:hover,
.contact-links a:hover strong {
  color: var(--accent) !important;
}

.career-signal {
  align-items: center;
  background: var(--ink);
  color: #fff;
  display: grid;
  gap: 10px 26px;
  grid-template-columns: auto minmax(0, 1fr) auto;
  margin: 0 auto;
  max-width: 1040px;
  padding: 26px 32px;
}

.career-signal > span {
  color: #b7f0df;
  font-family: var(--mono);
  font-size: 10px;
}

.career-signal strong {
  font-family: var(--serif);
  font-size: 18px;
}

.career-signal p {
  color: #b9b9c0;
  font-size: 11px;
  grid-column: 2;
  margin: 0;
}

.career-signal a {
  color: #fff !important;
  font-size: 11px;
  grid-column: 3;
  grid-row: 1 / span 2;
}

.career-signal a:hover {
  color: #b7f0df !important;
}

.career-signal .fa {
  font-size: 9px;
  margin-left: 7px;
}

.value-grid {
  display: grid;
  gap: 18px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 0 auto;
  max-width: 960px;
}

.value-grid article {
  border: 1px solid var(--line);
  border-radius: 4px;
  min-height: 250px;
  padding: 26px;
}

.value-grid article > span {
  color: var(--accent);
  font-family: var(--mono);
  font-size: 10px;
}

.value-grid h3 {
