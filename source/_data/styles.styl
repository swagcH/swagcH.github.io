.editorial-post-page .post-body img + br + em,
.editorial-post-page .post-body p > em:only-child {
  color: var(--muted);
  display: block;
  font-size: 11px;
  text-align: center;
}

.editorial-post-page .post-body table:not(.highlight table) {
  border: 1px solid var(--line);
  border-collapse: collapse;
  display: table;
  font-size: 13px;
  margin: 28px 0;
  width: 100%;
}

.editorial-post-page .post-body table:not(.highlight table) th,
.editorial-post-page .post-body table:not(.highlight table) td {
  border: 1px solid var(--line);
  padding: 10px 12px;
}

/* 深色代码块保留开发者博客的工具属性。 */
.editorial-post-page figure.highlight {
  background: var(--code-bg) !important;
  border: 0 !important;
  border-radius: 4px !important;
  box-shadow: none !important;
  color: var(--code-text) !important;
  margin: 30px 0 !important;
  -webkit-overflow-scrolling: touch;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 18px 0 16px !important;
  width: 100%;
}

.editorial-post-page figure.highlight .highlight-tools {
  background: transparent !important;
  border-bottom: 1px solid rgba(255, 255, 255, .08);
  color: #8d8d96 !important;
  height: 32px;
  line-height: 32px;
  margin: -18px 0 12px;
}

.editorial-post-page figure.highlight .code-lang {
  color: #8d8d96 !important;
  font-family: var(--mono);
  font-size: 10px;
  text-transform: uppercase;
}

.editorial-post-page figure.highlight .copy-btn {
  color: #9b9ba4 !important;
}

.editorial-post-page figure.highlight .copy-btn:hover {
  color: #fff !important;
}

.editorial-post-page figure.highlight .table-container {
  overflow-x: auto;
}

.editorial-post-page figure.highlight table {
  background: transparent !important;
  border: 0 !important;
  display: table !important;
  margin: 0 !important;
  table-layout: fixed !important;
  width: 100% !important;
}

.editorial-post-page figure.highlight tr {
  background: transparent !important;
}

.editorial-post-page figure.highlight td {
  background: transparent !important;
  border: 0 !important;
  padding: 0 !important;
}

.editorial-post-page figure.highlight .gutter {
  width: 48px !important;
}

.editorial-post-page figure.highlight .code {
  max-width: 0;
  width: auto !important;
}

.editorial-post-page figure.highlight pre {
  background: transparent !important;
  border: 0 !important;
  color: var(--code-text) !important;
  font-family: var(--mono) !important;
  font-size: 12px !important;
  line-height: 1.75 !important;
  margin: 0 !important;
  padding: 0 18px !important;
}

.editorial-post-page figure.highlight .gutter pre {
  border-right: 1px solid rgba(255, 255, 255, .08) !important;
  color: #66666e !important;
  padding-right: 12px !important;
  text-align: right;
}

.editorial-post-page figure.highlight .code pre {
  overflow-x: auto !important;
  padding-left: 15px !important;
  width: 100% !important;
}

.editorial-post-page figure.highlight code,
.editorial-post-page figure.highlight .line {
  background: transparent !important;
  color: inherit;
  padding: 0 !important;
}

.editorial-post-page .highlight .keyword,
.editorial-post-page .highlight .selector-tag,
.editorial-post-page .highlight .meta-keyword {
  color: #d6a0ff !important;
}

.editorial-post-page .highlight .string,
.editorial-post-page .highlight .title,
.editorial-post-page .highlight .name,
.editorial-post-page .highlight .attribute {
  color: #9edc9e !important;
}

.editorial-post-page .highlight .comment,
.editorial-post-page .highlight .quote {
  color: #7f8490 !important;
}

.editorial-post-page .post-footer {
  align-items: center;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  margin: 0 !important;
  min-height: 72px;
  padding: 16px 52px !important;
}

.editorial-post-page .post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin: 0;
}

.editorial-post-page .post-tags a {
  background: var(--paper);
  border: 1px solid var(--line-strong) !important;
  border-radius: 2px;
  color: var(--muted) !important;
  font-size: 10px;
  line-height: 1;
  margin: 0 !important;
  padding: 6px 8px;
}

.editorial-post-page .post-tags a:hover {
  border-color: var(--accent) !important;
  color: var(--accent) !important;
}

.post-share-actions {
  align-items: center;
  color: var(--muted);
  display: flex;
  font-size: 11px;
  gap: 9px;
}

.post-share-icon {
  align-items: center;
  background: transparent;
  border: 0 !important;
  color: var(--muted) !important;
  cursor: pointer;
  display: inline-flex;
  height: 30px;
  justify-content: center;
  padding: 0;
  width: 30px;
}

.post-share-icon:hover,
.post-share-icon.is-copied {
  color: var(--accent) !important;
}

.editorial-post-page .post-nav {
  display: none;
}

.post-series-navigation {
  border-top: 1px solid var(--line);
  padding: 48px 52px 54px;
}

.post-series-navigation > header {
  align-items: flex-end;
  display: flex;
  justify-content: space-between;
  margin: 0 auto 22px;
  max-width: 980px;
}

.post-series-navigation > header p {
  color: var(--muted);
  font-size: 10px;
  margin: 0 0 4px;
}

.post-series-navigation > header a {
  color: var(--ink) !important;
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 700;
}

.post-series-navigation > header a:hover {
  color: var(--accent) !important;
}

.post-series-navigation > header > span {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 10px;
}

.post-series-links {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin: 0 auto;
  max-width: 980px;
}

.post-series-link {
  background: var(--surface);
  border: 1px solid transparent;
  border-radius: 4px;
  color: var(--ink) !important;
  display: flex;
  flex-direction: column;
  min-height: 96px;
  padding: 19px 21px;
  transition: border-color 160ms ease;
}

.post-series-link:hover {
  border-color: var(--line-strong);
  color: var(--accent) !important;
}

.post-series-link small {
  color: var(--muted);
  font-size: 9px;
  margin-bottom: 8px;
}

.post-series-link strong {
  font-family: var(--serif);
  font-size: 14px;
  line-height: 1.55;
}

.post-series-link.is-empty {
  color: var(--muted) !important;
  opacity: .65;
}

.related-reading {
  border-top: 1px solid var(--line);
  padding: 58px 52px 76px;
}

.related-heading {
  align-items: baseline;
  display: flex;
  justify-content: space-between;
  margin: 0 auto 24px;
  max-width: 1080px;
}

.related-heading h2 {
  font-family: var(--serif);
  font-size: 24px;
  margin: 0;
}

.related-heading a {
  color: var(--accent);
  font-size: 12px;
}

.related-grid {
  display: grid;
  gap: 20px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 0 auto;
  max-width: 1080px;
}

.related-card {
  border: 1px solid var(--line);
  border-radius: 3px;
  min-width: 0;
  overflow: hidden;
}

.related-cover {
  background: var(--surface);
  display: block;
  overflow: hidden;
}

.related-cover img {
  aspect-ratio: 16 / 7;
  display: block;
  height: auto;
  margin: 0 !important;
  object-fit: cover;
  transition: transform 220ms ease;
  width: 100%;
}

.related-card:hover .related-cover img {
  transform: scale(1.025);
}

.related-content {
  padding: 17px 18px 18px;
}

.related-content > a {
  color: var(--ink) !important;
  display: -webkit-box;
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 650;
  line-height: 1.55;
  min-height: 46px;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.related-content > a:hover {
  color: var(--accent) !important;
}

.related-content p {
  color: var(--muted);
  font-size: 10px;
  margin: 8px 0 0;
}

/* 搜索弹层 */
.search-pop-overlay {
  align-items: flex-start !important;
  backdrop-filter: none;
  background: rgba(242, 242, 243, .97) !important;
  overflow-y: auto;
  padding: 68px 32px;
}

.search-popup {
  background: var(--paper) !important;
  border: 1px solid var(--line);
  border-radius: 0 !important;
  box-shadow: none !important;
  color: var(--ink) !important;
  height: calc(100vh - 136px) !important;
  margin: 0 auto !important;
  max-height: 760px;
  max-width: 1000px;
  padding: 0 70px 38px;
  width: 100% !important;
}

.search-page-heading {
  padding: 38px 0 18px;
  text-align: center;
}

.search-page-heading h2 {
  font-family: var(--serif);
  font-size: 30px;
  margin: 0;
}

.search-page-heading p {
  color: var(--muted);
  font-size: 11px;
  margin: 5px 0 0;
}

.search-popup .search-header {
  background: var(--paper) !important;
  border: 1px solid var(--line);
  border-radius: 0 !important;
  min-height: 46px;
  padding: 0 !important;
}

.search-popup .search-icon {
  align-items: center;
  color: var(--muted) !important;
  display: flex;
  font-size: 13px !important;
  padding: 0 13px !important;
}

.search-input-container {
  align-items: center;
  display: flex;
  padding: 0 !important;
}

.search-input {
  color: var(--ink) !important;
  font-size: 13px;
  height: 44px;
}

.search-submit {
  background: transparent;
  border: 0;
  border-left: 1px solid var(--line);
  color: var(--ink);
  cursor: pointer;
  font-size: 12px;
  height: 44px;
  padding: 0 17px;
}

.search-submit:hover {
  color: var(--accent);
}

.search-popup .popup-btn-close {
  align-items: center;
  color: var(--muted) !important;
  display: flex;
  font-size: 14px !important;
  padding: 0 13px !important;
}

.search-popup .search-result-container {
  height: calc(100% - 145px) !important;
  padding: 26px 0 0 !important;
}

.search-stats {
  color: var(--muted);
  flex-shrink: 0;
  font-size: 11px;
  padding-bottom: 12px;
}

.search-result-container hr {
  border-color: var(--line) !important;
  border-style: solid !important;
  border-width: 1px 0 0 !important;
  margin: 0 0 14px !important;
}

.search-result-list {
  list-style: none;
  margin: 0 !important;
  padding: 0 !important;
}

.search-result-list li {
  background: var(--surface);
  border: 0;
  margin-bottom: 16px;
  padding: 22px 24px 18px;
}

.search-result-title {
  color: var(--ink) !important;
  font-family: var(--serif);
  font-size: 17px;
}

.search-result-title:hover {
  color: var(--accent) !important;
}

.search-result {
  border-bottom: 0 !important;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.75;
  margin: 8px 0 0 !important;
  padding: 0 !important;
}

mark.search-keyword {
  background: var(--accent-soft);
  border-bottom: 0;
  color: var(--accent);
}

.search-result-icon {
  color: var(--line-strong) !important;
}

/* 页脚与固定工具 */
.footer {
  background: var(--paper) !important;
  border-top: 1px solid var(--line);
  color: var(--muted) !important;
  margin: 0 auto 96px !important;
  max-width: 1280px !important;
  padding: 0 52px !important;
  width: calc(100% - 96px) !important;
}

.footer-inner {
  align-items: center;
  display: flex;
  flex-direction: row !important;
  justify-content: space-between;
  min-height: 86px;
  padding: 0 !important;
  text-align: left !important;
  width: 100% !important;
}

.editorial-footer-brand {
  color: var(--ink) !important;
  font-family: var(--serif);
  font-size: 14px;
  font-weight: 700;
}

.editorial-footer-links {
  align-items: center;
  display: flex;
  gap: 20px;
}

.editorial-footer-links a {
  color: var(--muted) !important;
  font-size: 10px;
}

.editorial-footer-links a:hover {
  color: var(--accent) !important;
}

.copyright {
  font-size: 10px;
  margin: 0 !important;
}

.with-love {
  display: none;
}

.busuanzi-count,
.powered-by {
  display: none !important;
}

.back-to-top {
  align-items: center;
  background: var(--ink) !important;
  border-radius: 2px !important;
  bottom: 22px !important;
  color: #fff !important;
  display: flex;
  height: 42px;
  justify-content: center;
  left: auto !important;
  opacity: .9;
  padding: 0 !important;
  right: 22px !important;
  width: 42px !important;
}

.back-to-top span {
  display: none;
}

.reading-progress-bar {
  background: var(--accent) !important;
}

@media (max-width: 1180px) {
  .post-reading-layout {
    display: block;
    max-width: 780px;
  }

  .post-toc-rail {
    display: none;
  }

  .post-inline-toc {
    border-bottom: 1px solid var(--line);
    display: block;
    margin: 0 10px;
    padding: 24px 0 8px;
  }

  .post-inline-toc summary {
    color: var(--ink);
    cursor: pointer;
    font-family: var(--serif);
    font-size: 15px;
    font-weight: 700;
    list-style: none;
    padding: 0 0 14px;
  }

  .post-inline-toc summary::-webkit-details-marker {
    display: none;
  }

  .post-inline-toc summary::after {
    color: var(--accent);
    content: "+";
    float: right;
    font-family: var(--sans);
    font-weight: 400;
  }

  .post-inline-toc[open] summary::after {
    content: "−";
  }

  .post-inline-toc-list {
    border-top: 1px solid var(--line);
    padding: 10px 0 14px;
  }

  .post-inline-toc-list li {
    margin: 0;
  }

  .post-inline-toc-list a {
    color: var(--muted) !important;
    display: grid;
    font-size: 11px;
    gap: 10px;
    grid-template-columns: 22px minmax(0, 1fr);
    line-height: 1.6;
    padding: 6px 0;
  }

  .post-inline-toc-list .depth-3 a {
    padding-left: 18px;
  }

  .post-inline-toc-list a span {
    color: var(--faint);
    font-family: var(--mono);
    font-size: 8px;
  }
}

/* 中等尺寸 */
@media (max-width: 1000px) {
  .main,
  .footer {
    width: calc(100% - 40px) !important;
  }

  .main {
    margin-top: 20px !important;
  }

  .footer {
    margin-bottom: 40px !important;
  }

  .header {
    padding: 0 30px !important;
  }

  .main-inner.index {
    padding-left: 34px !important;
    padding-right: 34px !important;
  }

  .editorial-post-page .post-body {
    max-width: 720px !important;
  }

  .post-reading-layout {
    max-width: 720px;
  }

  .related-reading {
    padding-left: 36px;
    padding-right: 36px;
  }
}

