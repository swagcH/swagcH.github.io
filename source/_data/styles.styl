.post-body figure.highlight
  overflow-x: auto
  overflow-y: hidden
  width: 100%
  max-width: 100%

.post-body figure.highlight table
  table-layout: auto
  width: max-content
  min-width: 100%
  margin: 0

.post-body figure.highlight .gutter
  width: 3.2em
  min-width: 3.2em
  max-width: 3.2em
  white-space: nowrap
  user-select: none

.post-body figure.highlight .code
  width: auto
  min-width: max-content

.post-body figure.highlight pre,
.post-body figure.highlight .line
  white-space: pre
  word-break: normal
  overflow-wrap: normal

.post-body figure.highlight .code pre
  min-width: max-content
