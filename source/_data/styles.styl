:root
  --jng-bg #f6f2ea
  --jng-bg-soft rgba(255, 252, 246, .74)
  --jng-card rgba(255, 255, 255, .72)
  --jng-card-strong rgba(255, 255, 255, .88)
  --jng-text #2a2723
  --jng-muted #827970
  --jng-line rgba(86, 74, 58, .12)
  --jng-accent #e87538
  --jng-accent-2 #f2b66d
  --jng-shadow 0 24px 80px rgba(84, 66, 45, .14)
  --jng-shadow-soft 0 16px 44px rgba(84, 66, 45, .10)
  --jng-radius 30px
  --jng-radius-sm 18px
  --jng-blur saturate(150%) blur(22px)

html
  scroll-behavior smooth

body
  color var(--jng-text)
  background radial-gradient(circle at 10% -10%, rgba(242, 182, 109, .42), transparent 34%), radial-gradient(circle at 92% 8%, rgba(232, 117, 56, .24), transparent 30%), linear-gradient(135deg, #fbf7ef 0%, #f4eee4 45%, #ebe5dc 100%) !important
  min-height 100vh
  letter-spacing .01em

body::before
  content ''
  position fixed
  inset 0
  z-index -2
  pointer-events none
  background-image linear-gradient(rgba(60, 48, 36, .035) 1px, transparent 1px), linear-gradient(90deg, rgba(60, 48, 36, .035) 1px, transparent 1px)
  background-size 42px 42px
  mask-image linear-gradient(to bottom, rgba(0, 0, 0, .8), transparent 82%)

body::after
  content ''
  position fixed
  inset 0
  z-index -1
  pointer-events none
  opacity .42
  background-image radial-gradient(circle at 1px 1px, rgba(72, 58, 43, .18) 1px, transparent 0)
  background-size 18px 18px
  mix-blend-mode multiply

body.darkmode
  --jng-bg #12100e
  --jng-bg-soft rgba(28, 25, 22, .76)
  --jng-card rgba(34, 31, 27, .72)
  --jng-card-strong rgba(39, 35, 31, .88)
  --jng-text #f4ecdf
  --jng-muted #b5a89a
  --jng-line rgba(255, 236, 212, .14)
  --jng-accent #f2a365
  --jng-accent-2 #ffd08a
  --jng-shadow 0 26px 90px rgba(0, 0, 0, .34)
  --jng-shadow-soft 0 18px 54px rgba(0, 0, 0, .26)
  background radial-gradient(circle at 10% -10%, rgba(242, 163, 101, .22), transparent 34%), radial-gradient(circle at 92% 8%, rgba(232, 117, 56, .14), transparent 30%), linear-gradient(135deg, #15120f 0%, #1e1a16 48%, #141210 100%) !important

::selection
  color #fff8ed
  background var(--jng-accent)

.container
  background transparent

.main
  padding-bottom 68px

.main-inner
  max-width 1240px
  padding-top 24px

.header-inner
  background transparent
  border none
  box-shadow none

.site-brand-container
  overflow hidden
  position relative
  border 1px solid var(--jng-line)
  border-radius 0 0 var(--jng-radius) var(--jng-radius)
  background linear-gradient(145deg, rgba(255, 255, 255, .82), rgba(255, 244, 228, .58))
  box-shadow var(--jng-shadow-soft)
  backdrop-filter var(--jng-blur)

.site-brand-container::before
  content ''
  position absolute
  width 220px
  height 220px
  right -92px
  top -108px
  border-radius 50%
  background radial-gradient(circle, rgba(232, 117, 56, .36), transparent 68%)

.site-title
  color var(--jng-text)
  font-size 2.05em
  font-weight 700
  letter-spacing .08em
  line-height 1.2
  text-shadow none

.site-title::after
  content 'TECH NOTES'
  display block
  margin-top 10px
  color var(--jng-accent)
  font-family Optima, 'PingFang SC', sans-serif
  font-size .36em
  font-weight 600
  letter-spacing .32em

.site-subtitle
  color var(--jng-muted)
  font-size .92em
  letter-spacing .08em

.menu
  margin-top 18px
  padding 12px
  border 1px solid var(--jng-line)
  border-radius 999px
  background var(--jng-bg-soft)
  box-shadow var(--jng-shadow-soft)
  backdrop-filter var(--jng-blur)

.menu .menu-item
  margin 0 4px

.menu .menu-item a
  border-radius 999px
  color var(--jng-muted)
  font-weight 600
  letter-spacing .02em
  transition transform .28s ease, color .28s ease, background .28s ease, box-shadow .28s ease

.menu .menu-item a:hover,
.menu .menu-item-active a
  color #fff8ed
  background linear-gradient(135deg, var(--jng-accent), var(--jng-accent-2))
  box-shadow 0 10px 26px rgba(232, 117, 56, .25)
  transform translateY(-2px)

.sidebar
  background transparent

.sidebar-inner
  overflow hidden
  border 1px solid var(--jng-line)
  border-radius var(--jng-radius)
  background var(--jng-card)
  box-shadow var(--jng-shadow)
  backdrop-filter var(--jng-blur)

.sidebar-inner::before
  content ''
  display block
  height 7px
  background linear-gradient(90deg, var(--jng-accent), var(--jng-accent-2), transparent)

.site-author-image
  padding 4px
  border 1px solid rgba(232, 117, 56, .32)
  box-shadow 0 18px 42px rgba(232, 117, 56, .16)

.site-author-name
  color var(--jng-text)
  font-size 1.08em
  letter-spacing .06em

.site-description
  color var(--jng-muted)
  line-height 1.8

.site-state-item
  border-color var(--jng-line)

.site-state-item-count
  color var(--jng-accent)
  font-family Georgia, serif
  font-weight 700

.site-state-item-name
  color var(--jng-muted)

.links-of-author a,
.links-of-blogroll a
  border-radius 999px
  color var(--jng-muted)
  transition color .25s ease, background .25s ease, transform .25s ease

.links-of-author a:hover,
.links-of-blogroll a:hover
  color var(--jng-accent)
  background rgba(232, 117, 56, .08)
  transform translateX(3px)

.sidebar-nav .sidebar-nav-active
  color var(--jng-accent)
  border-bottom-color var(--jng-accent)

.post-block,
.pagination,
.comments,
.tabs-comment,
.sub-menu,
.main-inner > .comments,
.comment-position .comments
  overflow hidden
  border 1px solid var(--jng-line) !important
  border-radius var(--jng-radius) !important
  background var(--jng-card) !important
  box-shadow var(--jng-shadow) !important
  backdrop-filter var(--jng-blur)

.post-block
  position relative
  margin-bottom 28px
  padding 42px 48px !important
  transition transform .35s ease, box-shadow .35s ease, border-color .35s ease

.post-block::before
  content ''
  position absolute
  inset 0 0 auto 0
  height 6px
  background linear-gradient(90deg, var(--jng-accent), var(--jng-accent-2), rgba(255, 255, 255, 0))

.post-block::after
  content ''
  position absolute
  width 180px
  height 180px
  right -88px
  top -90px
  border-radius 50%
  background radial-gradient(circle, rgba(242, 182, 109, .22), transparent 68%)
  pointer-events none

.post-block:hover
  border-color rgba(232, 117, 56, .28) !important
  box-shadow 0 30px 90px rgba(84, 66, 45, .18) !important
  transform translateY(-4px)

.posts-expand .post-title
  margin-bottom 18px
  font-family Georgia, 'Times New Roman', 'PingFang SC', serif
  font-size 2.12em
  line-height 1.25
  letter-spacing .02em

.posts-expand .post-title-link
  color var(--jng-text)
  border-bottom none
  background linear-gradient(var(--jng-accent), var(--jng-accent)) left 94% / 0 2px no-repeat
  transition color .25s ease, background-size .32s ease

.posts-expand .post-title-link:hover
  color var(--jng-accent)
  background-size 100% 2px

.posts-expand .post-meta
  display inline-flex
  flex-wrap wrap
  gap 8px 14px
  margin 0 0 24px
  padding 8px 14px
  border 1px solid var(--jng-line)
  border-radius 999px
  color var(--jng-muted)
  background rgba(255, 255, 255, .34)
  font-size .86em

.post-body
  color var(--jng-text)
  font-size 1.02em
  line-height 2.05

.post-body h1,
.post-body h2,
.post-body h3,
.post-body h4
  color var(--jng-text)
  font-family Georgia, 'Times New Roman', 'PingFang SC', serif
  letter-spacing .02em

.post-body h2
  position relative
  margin-top 2.2em
  padding-left 18px

.post-body h2::before
  content ''
  position absolute
  left 0
  top .32em
  width 5px
  height 1.05em
  border-radius 999px
  background linear-gradient(var(--jng-accent), var(--jng-accent-2))

.post-body a
  color var(--jng-accent)
  border-bottom 1px solid rgba(232, 117, 56, .32)

.post-body blockquote
  margin 28px 0
  padding 20px 24px
  border-left 4px solid var(--jng-accent)
  border-radius 0 var(--jng-radius-sm) var(--jng-radius-sm) 0
  color var(--jng-muted)
  background rgba(232, 117, 56, .08)

.post-body img
  border-radius 24px
  box-shadow var(--jng-shadow-soft)

.post-tags a
  border 1px solid rgba(232, 117, 56, .28)
  border-radius 999px
  color var(--jng-accent)
  background rgba(232, 117, 56, .08)
  transition background .25s ease, color .25s ease, transform .25s ease

.post-tags a:hover
  color #fff8ed
  background var(--jng-accent)
  transform translateY(-2px)

.btn,
.post-button .btn
  border 1px solid rgba(232, 117, 56, .34)
  border-radius 999px
  color #fff8ed
  background linear-gradient(135deg, var(--jng-accent), var(--jng-accent-2))
  box-shadow 0 12px 30px rgba(232, 117, 56, .22)
  transition transform .25s ease, box-shadow .25s ease

.btn:hover,
.post-button .btn:hover
  color #fff8ed
  transform translateY(-2px)
  box-shadow 0 16px 36px rgba(232, 117, 56, .30)

.highlight,
pre,
code
  border-radius var(--jng-radius-sm)

.highlight
  overflow hidden
  border 1px solid var(--jng-line)
  box-shadow var(--jng-shadow-soft)

code
  color #c15d2c
  background rgba(232, 117, 56, .10)

.table-container table,
table
  overflow hidden
  border-radius var(--jng-radius-sm)

.pagination
  padding 16px !important

.pagination .page-number,
.pagination .extend
  border-radius 999px
  transition color .25s ease, background .25s ease, transform .25s ease

.pagination .page-number.current,
.pagination .page-number:hover,
.pagination .extend:hover
  color #fff8ed
  background var(--jng-accent)
  transform translateY(-2px)

.back-to-top
  right 28px
  bottom 28px
  border 1px solid var(--jng-line)
  border-radius 999px
  color var(--jng-accent)
  background var(--jng-card-strong)
  box-shadow var(--jng-shadow-soft)
  backdrop-filter var(--jng-blur)

.footer
  color var(--jng-muted)

.footer-inner
  padding 28px 0

.search-pop-overlay
  background rgba(24, 20, 16, .28)
  backdrop-filter blur(12px)

.search-popup
  border 1px solid var(--jng-line)
  border-radius var(--jng-radius)
  background var(--jng-card-strong)
  box-shadow var(--jng-shadow)
  backdrop-filter var(--jng-blur)

.search-input-container
  border-bottom-color var(--jng-line)

.search-input
  color var(--jng-text)

.use-motion
  opacity 1 !important
  visibility visible !important

  .menu-item,
  .sidebar,
  .sidebar-inner,
  .post-block,
  .pagination,
  .comments,
  .post-header,
  .post-body,
  .collection-header,
  .column,
  .site-brand-container .toggle,
  .footer,
  .site-title,
  .site-subtitle,
  .custom-logo-image,
  .logo-line
    opacity 1 !important
    visibility visible !important

  .animated
    visibility inherit !important

  .sidebar .animated
    animation none !important
    opacity 1 !important
    visibility visible !important

@media (max-width: 991px)
  .main-inner
    padding 14px

  .menu
    border-radius 24px

  .post-block
    padding 32px 24px !important

  .posts-expand .post-title
    font-size 1.72em

@media (max-width: 767px)
  body::before
    background-size 30px 30px

  .site-brand-container
    border-radius 0 0 24px 24px

  .site-title
    font-size 1.62em

  .post-block,
  .sidebar-inner,
  .pagination,
  .comments
    border-radius 24px !important

  .post-block
    padding 28px 20px !important

  .posts-expand .post-meta
    border-radius 18px

  .post-body
    font-size 1em
    line-height 1.92
