:root
  --geek-bg #f3f4f6
  --geek-bg-2 #e5e7eb
  --geek-panel rgba(255, 255, 255, .86)
  --geek-panel-solid #ffffff
  --geek-text #111827
  --geek-muted #6b7280
  --geek-subtle #9ca3af
  --geek-line rgba(17, 24, 39, .12)
  --geek-line-strong rgba(17, 24, 39, .24)
  --geek-accent #111827
  --geek-signal #22c55e
  --geek-code #0f172a
  --geek-code-text #d1d5db
  --geek-shadow 0 22px 60px rgba(17, 24, 39, .08)
  --geek-shadow-soft 0 12px 32px rgba(17, 24, 39, .06)
  --geek-radius 18px
  --geek-radius-sm 10px
  --geek-font Menlo, Monaco, Consolas, 'SFMono-Regular', 'Liberation Mono', 'PingFang SC', monospace
  --geek-blur saturate(120%) blur(14px)

html
  scroll-behavior smooth

body
  color var(--geek-text)
  min-height 100vh
  background linear-gradient(180deg, #f8fafc 0%, var(--geek-bg) 48%, #e5e7eb 100%) !important
  font-family var(--geek-font)
  letter-spacing -.015em

body::before
  content ''
  position fixed
  inset 0
  z-index -2
  pointer-events none
  background-image linear-gradient(rgba(17, 24, 39, .055) 1px, transparent 1px), linear-gradient(90deg, rgba(17, 24, 39, .055) 1px, transparent 1px)
  background-size 32px 32px
  mask-image linear-gradient(to bottom, rgba(0, 0, 0, .92), transparent 78%)

body::after
  content ''
  position fixed
  inset 0
  z-index -1
  pointer-events none
  opacity .55
  background linear-gradient(rgba(255, 255, 255, .2) 50%, rgba(0, 0, 0, .025) 50%)
  background-size 100% 4px

body.darkmode
  --geek-bg #0d1117
  --geek-bg-2 #010409
  --geek-panel rgba(22, 27, 34, .86)
  --geek-panel-solid #161b22
  --geek-text #e6edf3
  --geek-muted #8b949e
  --geek-subtle #6e7681
  --geek-line rgba(240, 246, 252, .10)
  --geek-line-strong rgba(240, 246, 252, .20)
  --geek-accent #e6edf3
  --geek-signal #3fb950
  --geek-code #010409
  --geek-code-text #c9d1d9
  --geek-shadow 0 26px 70px rgba(0, 0, 0, .34)
  --geek-shadow-soft 0 16px 38px rgba(0, 0, 0, .28)
  background radial-gradient(circle at 70% -10%, rgba(139, 148, 158, .12), transparent 34%), linear-gradient(180deg, #0d1117 0%, #080b10 48%, #010409 100%) !important

body.darkmode::before
  background-image linear-gradient(rgba(240, 246, 252, .055) 1px, transparent 1px), linear-gradient(90deg, rgba(240, 246, 252, .055) 1px, transparent 1px)

body.darkmode::after
  opacity .28
  background linear-gradient(rgba(255, 255, 255, .025) 50%, rgba(0, 0, 0, .08) 50%)
  background-size 100% 4px

::selection
  color #010409
  background var(--geek-signal)

.container
  background transparent

.main
  padding-bottom 68px

.main-inner
  max-width 1240px
  padding-top 24px

.header-inner
  background transparent
  border none
  box-shadow none

.site-brand-container
  overflow hidden
  position relative
  border 1px solid var(--geek-line)
  border-radius 0 0 var(--geek-radius) var(--geek-radius)
  background var(--geek-panel)
  box-shadow var(--geek-shadow-soft)
  backdrop-filter var(--geek-blur)

.site-brand-container::before
  content '$ whoami'
  position absolute
  left 22px
  top 18px
  color var(--geek-signal)
  font-size .72em
  letter-spacing .02em

.site-brand-container::after
  content ''
  position absolute
  right 20px
  top 20px
  width 9px
  height 9px
  border-radius 50%
  background var(--geek-signal)
  box-shadow 16px 0 0 var(--geek-subtle), 32px 0 0 var(--geek-line-strong)

.site-title
  color var(--geek-text)
  margin-top 22px
  font-size 1.72em
  font-family var(--geek-font)
  font-weight 800
  letter-spacing -.04em
  line-height 1.2
  text-shadow none

.site-title::before
  content './'
  color var(--geek-muted)
  font-weight 500

.site-title::after
  content '_'
  display inline-block
  margin-left 4px
  color var(--geek-signal)
  animation geek-caret 1.1s steps(1, end) infinite

.site-subtitle
  color var(--geek-muted)
  font-size .86em
  letter-spacing -.02em

.menu
  margin-top 18px
  padding 8px
  border 1px solid var(--geek-line)
  border-radius var(--geek-radius)
  background var(--geek-panel)
  box-shadow var(--geek-shadow-soft)
  backdrop-filter var(--geek-blur)

.menu .menu-item
  margin 3px

.menu .menu-item a
  border 1px solid transparent
  border-radius var(--geek-radius-sm)
  color var(--geek-muted)
  font-family var(--geek-font)
  font-size .92em
  font-weight 700
  letter-spacing -.03em
  transition transform .2s ease, color .2s ease, background .2s ease, border-color .2s ease

.menu .menu-item a:hover,
.menu .menu-item-active a
  color var(--geek-text)
  background rgba(17, 24, 39, .06)
  border-color var(--geek-line-strong)
  transform translateY(-1px)

body.darkmode .menu .menu-item a:hover,
body.darkmode .menu .menu-item-active a
  background rgba(240, 246, 252, .07)

.sidebar
  background transparent

.sidebar-inner
  overflow hidden
  border 1px solid var(--geek-line)
  border-radius var(--geek-radius)
  background var(--geek-panel)
  box-shadow var(--geek-shadow)
  backdrop-filter var(--geek-blur)

.sidebar-inner::before
  content ''
  display block
  height 36px
  border-bottom 1px solid var(--geek-line)
  background linear-gradient(90deg, var(--geek-panel-solid), rgba(156, 163, 175, .12))

.sidebar-inner::after
  content 'status: online'
  position absolute
  top 10px
  left 18px
  color var(--geek-muted)
  font-size .76em

.site-author-image
  padding 3px
  border 1px solid var(--geek-line-strong)
  border-radius 12px
  background var(--geek-bg)
  box-shadow none
  filter grayscale(1) contrast(1.05)

.site-author-name
  color var(--geek-text)
  font-size 1em
  font-family var(--geek-font)
  letter-spacing -.03em

.site-author-name::before
  content 'dev@blog:~$ '
  color var(--geek-signal)
  font-weight 500

.site-description
  color var(--geek-muted)
  line-height 1.75
  font-size .86em

.site-state-item
  border-color var(--geek-line)

.site-state-item-count
  color var(--geek-text)
  font-family var(--geek-font)
  font-weight 800

.site-state-item-name
  color var(--geek-muted)

.links-of-author a,
.links-of-blogroll a
  border-radius var(--geek-radius-sm)
  color var(--geek-muted)
  transition color .2s ease, background .2s ease, transform .2s ease

.links-of-author a:hover,
.links-of-blogroll a:hover
  color var(--geek-text)
  background rgba(139, 148, 158, .12)
  transform translateX(3px)

.sidebar-nav .sidebar-nav-active
  color var(--geek-text)
  border-bottom-color var(--geek-signal)

.post-block,
.pagination,
.comments,
.tabs-comment,
.sub-menu,
.main-inner > .comments,
.comment-position .comments
  overflow hidden
  border 1px solid var(--geek-line) !important
  border-radius var(--geek-radius) !important
  background var(--geek-panel) !important
  box-shadow var(--geek-shadow) !important
  backdrop-filter var(--geek-blur)

.post-block
  position relative
  margin-bottom 26px
  padding 40px 46px !important
  transition transform .24s ease, box-shadow .24s ease, border-color .24s ease

.post-block::before
  content 'commit --amend'
  position absolute
  left 0
  right 0
  top 0
  height 34px
  padding 9px 18px 0
  box-sizing border-box
  border-bottom 1px solid var(--geek-line)
  color var(--geek-muted)
  background linear-gradient(90deg, rgba(17, 24, 39, .045), transparent)
  font-size .72em

body.darkmode .post-block::before
  background linear-gradient(90deg, rgba(240, 246, 252, .045), transparent)

.post-block::after
  content ''
  position absolute
  right 18px
  top 13px
  width 7px
  height 7px
  border-radius 50%
  background var(--geek-signal)
  box-shadow 13px 0 0 var(--geek-subtle), 26px 0 0 var(--geek-line-strong)
  pointer-events none

.post-block:hover
  border-color var(--geek-line-strong) !important
  box-shadow 0 26px 74px rgba(17, 24, 39, .12) !important
  transform translateY(-2px)

.posts-expand .post-title
  margin 18px 0 16px
  font-family var(--geek-font)
  font-size 1.82em
  line-height 1.32
  letter-spacing -.06em

.posts-expand .post-title-link
  color var(--geek-text)
  border-bottom none
  background linear-gradient(var(--geek-line-strong), var(--geek-line-strong)) left 96% / 0 1px no-repeat
  transition color .2s ease, background-size .24s ease

.posts-expand .post-title-link::before
  content 'fn '
  color var(--geek-signal)
  font-weight 500

.posts-expand .post-title-link:hover
  color var(--geek-text)
  background-size 100% 1px

.posts-expand .post-meta
  display inline-flex
  flex-wrap wrap
  gap 8px 12px
  margin 0 0 24px
  padding 7px 12px
  border 1px solid var(--geek-line)
  border-radius var(--geek-radius-sm)
  color var(--geek-muted)
  background rgba(139, 148, 158, .08)
  font-size .78em
  letter-spacing -.03em

.post-body
  color var(--geek-text)
  font-size .98em
  line-height 1.9

.post-body h1,
.post-body h2,
.post-body h3,
.post-body h4
  color var(--geek-text)
  font-family var(--geek-font)
  letter-spacing -.055em

.post-body h2
  position relative
  margin-top 2.15em
  padding-left 18px

.post-body h2::before
  content '#'
  position absolute
  left 0
  top 0
  color var(--geek-signal)
  font-weight 500

.post-body a
  color var(--geek-text)
  border-bottom 1px dashed var(--geek-line-strong)

.post-body a:hover
  color var(--geek-signal)
  border-bottom-color var(--geek-signal)

.post-body blockquote
  margin 28px 0
  padding 18px 22px
  border-left 3px solid var(--geek-line-strong)
  border-radius 0 var(--geek-radius-sm) var(--geek-radius-sm) 0
  color var(--geek-muted)
  background rgba(139, 148, 158, .10)

.post-body blockquote::before
  color var(--geek-subtle)

.post-body img
  border 1px solid var(--geek-line)
  border-radius var(--geek-radius-sm)
  box-shadow var(--geek-shadow-soft)
  filter grayscale(.16)

.post-tags a
  border 1px solid var(--geek-line)
  border-radius var(--geek-radius-sm)
  color var(--geek-muted)
  background rgba(139, 148, 158, .09)
  transition background .2s ease, color .2s ease, border-color .2s ease, transform .2s ease

.post-tags a::before
  content '#'
  color var(--geek-signal)

.post-tags a:hover
  color var(--geek-text)
  border-color var(--geek-line-strong)
  background rgba(139, 148, 158, .16)
  transform translateY(-1px)

.btn,
.post-button .btn
  border 1px solid var(--geek-line-strong)
  border-radius var(--geek-radius-sm)
  color var(--geek-text)
  background transparent
  box-shadow none
  font-family var(--geek-font)
  transition transform .2s ease, background .2s ease, color .2s ease, border-color .2s ease

.btn::before,
.post-button .btn::before
  content '> '
  color var(--geek-signal)

.btn:hover,
.post-button .btn:hover
  color var(--geek-text)
  background rgba(139, 148, 158, .14)
  border-color var(--geek-text)
  transform translateY(-1px)

.highlight,
pre,
code
  border-radius var(--geek-radius-sm)
  font-family var(--geek-font)

.highlight
  overflow hidden
  border 1px solid var(--geek-line-strong)
  background var(--geek-code) !important
  box-shadow var(--geek-shadow-soft)

.highlight::before
  content 'terminal'
  display block
  height 28px
  padding 7px 12px 0
  box-sizing border-box
  border-bottom 1px solid rgba(240, 246, 252, .10)
  color #8b949e
  background #0d1117
  font-size .72em

code
  color var(--geek-text)
  background rgba(139, 148, 158, .14)
  border 1px solid var(--geek-line)

.table-container table,
table
  overflow hidden
  border 1px solid var(--geek-line)
  border-radius var(--geek-radius-sm)

th
  background rgba(139, 148, 158, .12)

.pagination
  padding 14px !important

.pagination .page-number,
.pagination .extend
  border-radius var(--geek-radius-sm)
  transition color .2s ease, background .2s ease, transform .2s ease

.pagination .page-number.current,
.pagination .page-number:hover,
.pagination .extend:hover
  color var(--geek-text)
  background rgba(139, 148, 158, .16)
  transform translateY(-1px)

.back-to-top
  right 28px
  bottom 28px
  border 1px solid var(--geek-line)
  border-radius var(--geek-radius-sm)
  color var(--geek-text)
  background var(--geek-panel)
  box-shadow var(--geek-shadow-soft)
  backdrop-filter var(--geek-blur)

.footer
  color var(--geek-muted)
  font-family var(--geek-font)

.footer-inner
  padding 28px 0

.search-pop-overlay
  background rgba(1, 4, 9, .42)
  backdrop-filter blur(10px)

.search-popup
  border 1px solid var(--geek-line)
  border-radius var(--geek-radius)
  background var(--geek-panel-solid)
  box-shadow var(--geek-shadow)

.search-input-container
  border-bottom-color var(--geek-line)

.search-input
  color var(--geek-text)
  font-family var(--geek-font)

.use-motion
  opacity 1 !important
  visibility visible !important

  .menu-item,
  .sidebar,
  .sidebar-inner,
  .post-block,
  .pagination,
  .comments,
  .post-header,
  .post-body,
  .collection-header,
  .column,
  .site-brand-container .toggle,
  .footer,
  .site-title,
  .site-subtitle,
  .custom-logo-image,
  .logo-line
    opacity 1 !important
    visibility visible !important

  .animated
    visibility inherit !important

  .sidebar .animated
    animation none !important
    opacity 1 !important
    visibility visible !important

@keyframes geek-caret
  0%, 48%
    opacity 1
  49%, 100%
    opacity 0

@media (max-width: 991px)
  .main-inner
    padding 14px

  .menu
    border-radius 14px

  .post-block
    padding 34px 24px !important

  .posts-expand .post-title
    font-size 1.52em

@media (max-width: 767px)
  body::before
    background-size 24px 24px

  .site-brand-container
    border-radius 0 0 14px 14px

  .site-title
    font-size 1.38em

  .post-block,
  .sidebar-inner,
  .pagination,
  .comments
    border-radius 14px !important

  .post-block
    padding 34px 18px 24px !important

  .posts-expand .post-meta
    border-radius 10px

  .post-body
    font-size .96em
    line-height 1.82
