  .experience-list time {
    padding: 0;
  }

  .contact-links {
    align-items: flex-start;
    flex-direction: column;
    gap: 20px;
    max-width: 210px;
  }

  .career-signal {
    gap: 8px;
    grid-template-columns: 1fr;
    margin: 0 20px;
    padding: 24px;
  }

  .career-signal p,
  .career-signal a {
    grid-column: 1;
    grid-row: auto;
  }

  .career-signal a {
    margin-top: 7px;
  }

  .value-grid {
    grid-template-columns: 1fr;
  }

  .value-grid article {
    min-height: 220px;
    padding: 24px;
  }

  .proof-list > a {
    gap: 5px;
    grid-template-columns: 1fr;
    padding: 20px 0;
  }

  .proof-list small {
    text-align: left;
  }

  .contact-intro {
    margin-top: -18px;
    text-align: left;
  }

  .contact-section .contact-links {
    gap: 20px;
    max-width: 240px;
  }

  .category-all {
    padding: 0 20px 58px;
  }

  .career-track-section {
    padding: 0 20px 58px;
  }

  .career-track-grid {
    grid-template-columns: 1fr;
  }

  .career-track-card {
    min-height: 240px;
    padding: 22px;
  }

  .category-grid {
    grid-template-columns: 1fr;
  }

  .category-card {
    min-height: 138px;
    padding: 22px !important;
  }

  .category-list-count {
    right: 22px;
    top: 25px;
  }

  .category-featured {
    padding: 52px 20px 58px;
  }

  .category-featured-list article {
    align-items: flex-start;
    gap: 7px;
    grid-template-columns: 1fr;
  }

  .series-overview {
    padding: 30px 20px 58px;
  }

  .series-overview h2 {
    font-size: 26px;
  }

  .series-detail {
    padding: 56px 20px 64px;
  }

  .series-detail-header {
    gap: 10px;
    grid-template-columns: 1fr;
    margin-bottom: 32px;
  }

  .series-detail-index {
    padding: 0;
  }

  .series-detail-copy h2 {
    font-size: 29px;
  }

  .series-detail-metrics {
    align-items: baseline;
    flex-direction: row;
    gap: 10px;
    padding: 6px 0 0;
  }

  .series-reading-item {
    align-items: start;
    gap: 12px;
    grid-template-columns: 26px minmax(0, 1fr);
    min-height: 0;
    padding: 20px 0;
  }

  .series-reading-item > div > a {
    font-size: 16px;
  }

  .series-reading-item p {
    -webkit-line-clamp: 2;
  }

  .series-reading-arrow {
    display: none;
  }

  .archive-page {
    padding-bottom: 58px;
  }

  .archive-hero {
    min-height: 260px;
  }

  .archive-filters {
    flex-wrap: nowrap;
    justify-content: flex-start;
    margin-bottom: 34px;
    max-width: 100%;
    overflow-x: auto;
    padding: 0 20px 7px;
    scrollbar-width: none;
  }

  .archive-filters::-webkit-scrollbar {
    display: none;
  }

  .archive-filters button {
    flex: 0 0 auto;
  }

  .archive-timeline {
    padding: 0 20px;
  }

  .archive-year-group + .archive-year-group {
    margin-top: 42px;
  }

  .archive-year-group h2 {
    font-size: 26px;
  }

  .archive-row {
    align-items: start;
    gap: 3px 12px;
    grid-template-columns: 52px minmax(0, 1fr);
    min-height: 56px;
    padding: 10px 4px;
  }

  .archive-row time {
    font-size: 10px;
    padding-top: 4px;
  }

  .archive-post-link {
    font-size: 14px;
  }

  .archive-category {
    grid-column: 2;
    text-align: left;
  }

  .editorial-archive-page .posts-collapse > .post-block {
    padding-left: 20px;
    padding-right: 20px;
  }

  .post-author-bar {
    align-items: flex-start;
    gap: 16px;
    min-height: 0;
    padding: 20px;
  }

  .post-author-identity img {
    height: 38px;
    width: 38px;
  }

  .post-author-identity small {
    display: none;
  }

  .post-quick-meta {
    align-items: flex-end;
    flex-direction: column;
    gap: 2px;
    text-align: right;
  }

  .post-quick-meta > * + *::before {
    display: none;
  }

  .editorial-post-page .post-header {
    padding: 40px 20px 42px !important;
  }

  .editorial-post-page .post-title {
    font-size: 32px !important;
    line-height: 1.4 !important;
  }

  .post-deck {
    font-size: 14px;
    line-height: 1.75;
  }

  .editorial-post-page .post-body {
    font-size: 15px !important;
    line-height: 1.9 !important;
    max-width: none !important;
    padding: 34px 20px 48px !important;
  }

  .post-inline-toc {
    margin: 0 20px;
  }

  .post-proof-strip {
    align-items: flex-start;
    gap: 8px;
    margin: 0 20px;
    padding: 16px 0;
  }

  .editorial-post-page .post-body h1 {
    font-size: 25px;
  }

  .editorial-post-page .post-body h2 {
    font-size: 22px;
  }

  .editorial-post-page .post-body h3 {
    font-size: 19px;
  }

  .editorial-post-page .post-body blockquote {
    padding: 19px 18px 17px 44px;
  }

  .editorial-post-page figure.highlight {
    border-radius: 3px !important;
  }

  .editorial-post-page figure.highlight pre {
    font-size: 11px !important;
  }

  .editorial-post-page .post-footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
    padding: 20px !important;
  }

  .post-share-actions {
    align-self: flex-end;
  }

  .post-series-navigation {
    padding: 38px 20px 44px;
  }

  .post-series-navigation > header a {
    font-size: 19px;
  }

  .post-series-links {
    grid-template-columns: 1fr;
  }

  .related-reading {
    padding: 44px 20px 54px;
  }

  .related-grid {
    grid-template-columns: 1fr;
  }

  .related-card {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
  }

  .related-cover img {
    aspect-ratio: 1 / 1;
    height: 100%;
  }

  .related-content {
    align-self: center;
    padding: 14px;
  }

  .related-content > a {
    font-size: 14px;
    min-height: 0;
  }

  .search-pop-overlay {
    padding: 0;
  }

  .search-popup {
    border: 0;
    height: 100% !important;
    max-width: none;
    padding: 0 20px 24px;
  }

  .search-page-heading {
    padding: 30px 0 15px;
  }

  .search-page-heading h2 {
    font-size: 26px;
  }

  .search-popup .search-icon {
    display: none;
  }

  .search-popup .search-result-container {
    height: calc(100% - 128px) !important;
  }

  .search-result-list li {
    padding: 18px;
  }

  .footer-inner {
    min-height: 72px;
  }

  .editorial-footer-links {
    display: none;
  }

  .copyright {
    max-width: 180px;
    text-align: right;
  }

  .back-to-top {
    bottom: 14px !important;
    height: 38px;
    right: 14px !important;
    width: 38px !important;
  }
}

@media (max-width: 420px) {
  .editorial-home-intro {
    grid-template-columns: 68px minmax(0, 1fr);
  }

  .home-avatar {
    height: 68px;
    width: 68px;
  }

  .home-intro-copy h1 {
    font-size: 31px;
  }

  .home-stats {
    grid-column: 1 / -1;
  }

  .about-intro {
    grid-template-columns: 92px minmax(0, 1fr);
  }

  .about-avatar {
    height: 92px;
    width: 92px;
  }

  .editorial-post-page .post-title {
    font-size: 29px !important;
  }

  .post-author-bar {
    padding-left: 16px;
    padding-right: 16px;
  }

  .related-card {
    grid-template-columns: 108px minmax(0, 1fr);
  }
}
